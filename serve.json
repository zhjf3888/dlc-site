{
  "cleanUrls": false,
  "trailingSlash": false,
  "caching": [
    { "source": "**/*.@(mp4|webp|jpg|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "**/*.@(css|vtt|html)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
